nh DoT trong 16s\n"}]},{"type":"paragraph","id":"line-7302","runs":[{"text":"Note: Skill triệu hồi Skeleton Battle Pet (chỉ xuất hiện khi không combat hoặc không dùng pet và không trong PvP).\n"}]},{"type":"paragraph","id":"line-7303","runs":[{"text":"\tP\n"}]},{"type":"paragraph","id":"line-7306","runs":[{"text":"\tPassive\n"}]},{"type":"paragraph","id":"line-7307","runs":[{"text":"Rank 4\n"}]},{"type":"paragraph","id":"line-7308","runs":[{"text":"\tSelf -30% Magi In, 20% Haste và 10% Hit Chance\n"}]},{"type":"paragraph","id":"line-7311","runs":[{"text":"\tPassive\n"}]},{"type":"paragraph","id":"line-7312","runs":[{"text":"Rank 10\n"}]},{"type":"paragraph","id":"line-7313","runs":[{"text":"\tSelf 15% All Out\n"}]}]}],"acquisition":{"classId":"necromancer-necro-pinkomancer","methods":[{"id":"necromancer-ac-shop-0","classId":"necromancer-necro-pinkomancer","type":"shop","variantName":"Necromancer (AC)","isAvailable":null,"availability":"seasonal","verificationStatus":"verified","detailsStatus":"complete","source":"https://aqwwiki.wikidot.com/necromancer-ac","sourceHash":"a8916ff628553a705da468f416c6eff1a2e27ccf6c229c8f437af45f73557397","prerequisites":[],"notes":[],"membershipRequirement":null,"levelRequirement":null,"baseLevel":null,"evidence":{"classPage":"https://aqwwiki.wikidot.com/necromancer-ac","linkedSource":"https://aqwwiki.wikidot.com/class-shop","priceText":"2,000 AC","locationText":["Class Shop 8-Bit Battleon Battleon Book of Lore Class Hall B Class Hall C Game Menu Northpointe"],"linkedSourceHash":"653295cbfa5c01bee530f4cd52c4753465349b0b0fed6bfec1c859d2ab88b06e","availabilityTags":[],"issues":[]},"shop":{"shopName":"Class Shop","source":"https://aqwwiki.wikidot.com/class-shop","npc":null,"map":"8-Bit Battleon / Battleon / Book of Lore / Class Hall B / Class Hall C / Game Menu / Northpointe","price":{"amount":2000,"currency":"AC","sourceText":"2,000 AC"}},"acquisitionKind":"ac_purchase","purchaseKind":"ac_purchase","verifiedFields":{"shopName":"Class Sho