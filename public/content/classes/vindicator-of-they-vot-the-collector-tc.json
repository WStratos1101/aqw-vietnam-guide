[{"text":"Self bị dính DoT trong 5s - hiệu ứng “Transmuted”\n"}]},{"type":"paragraph","id":"line-9306","runs":[{"text":"Self -40% All In trong 10s nếu mục tiêu miễn nhiễm Stun\n"}]},{"type":"paragraph","id":"line-9307","runs":[{"text":"\t5\n"}]},{"type":"paragraph","id":"line-9310","runs":[{"text":"\tArtificial Environment\n"}]},{"type":"paragraph","id":"line-9311","runs":[{"text":"30 MP - CD 10s\n"}]},{"type":"paragraph","id":"line-9312","runs":[{"text":"Magi - 1 target\n"}]},{"type":"paragraph","id":"line-9313","runs":[{"text":"\tEnemy bị dính DoT trong 10s (30% Magi DMG mỗi tick, max 150%)\n"}]},{"type":"paragraph","id":"line-9314","runs":[{"text":"Enemy -30% All Out trong 10s\n"}]},{"type":"paragraph","id":"line-9315","runs":[{"text":"Note: \n"}]},{"type":"paragraph","id":"line-9316","runs":[{"text":"- Skill gây 500% Magi DMG\n"}]},{"type":"paragraph","id":"line-9317","runs":[{"text":"- Tăng 25% DMG của skill này khi có “Transmuted”, đồng thời tiêu hao hiệu ứng này\n"}]},{"type":"paragraph","id":"line-9318","runs":[{"text":"\tP\n"}]},{"type":"paragraph","id":"line-9321","runs":[{"text":"\tPassive\n"}]},{"type":"paragraph","id":"line-9322","runs":[{"text":"Rank 4\n"}]},{"type":"paragraph","id":"line-9323","runs":[{"text":"\tSelf 10% Hit Chance, 20% All Out và 25% Haste\n"}]},{"type":"paragraph","id":"line-9326","runs":[{"text":"\tPassive\n"}]},{"type":"paragraph","id":"line-9327","runs":[{"text":"Rank 10\n"}]},{"type":"paragraph","id":"line-9328","runs":[{"text":"\tKhi dùng tất cả skills có cơ hội kích hoạt thêm:\n"}]},{"type":"paragraph","id":"line-9329","runs":[{"text":"Self có 1% cơ hội không giới hạn Mana và HoT lớn trong 8s\n"}]},{"type":"paragraph","id":"line-9330","runs":[{"text":"\tNote: Vindicator Of They và The Collector về cơ bản là như nhau, chỉ khác nhau về icon cũng như tên của hiệu ứng với skill.\n"}]}]}],"acquisition":{"classId":"vindicator-of-they-vot-the-collector-tc","methods":[{"id":"vindicator-of-they-ac-shop-0","classId":"vindicator-of-they-