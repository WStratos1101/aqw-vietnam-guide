{"sections":[{"id":"noi-dung","title":"Nội dung hướng dẫn","paragraphs":[],"blocks":[{"type":"paragraph","id":"p-185595","runs":[{"text":"Cuối cùng, mối đe dọa mà Malgor và đội quân ShadowFlame của hắn gây ra đã chấm dứt, nhưng những vết sẹo mà hắn gây ra vẫn còn đó... và kiến ​​thức bạn thu được cũng vậy. Các vị thần và Greater Beings of the Old Worlds Order đã được tiết lộ, và bây giờ bạn phải hoàn thành nhiệm vụ mà họ đặt ra: vô hiệu hóa ba mối đe dọa nghiêm trọng trước khi chúng thức tỉnh. Hãy tiếp tục cuộc hành trình của bạn tại Termina Temple.\n"}]},{"type":"table","id":"table-186013","rows":[{"cells":[{"colSpan":1,"rowSpan":3,"blocks":[{"type":"paragraph","id":"p-186016","runs":[{"text":"Thứ tự\n","bold":true}]}]},{"colSpan":6,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-186024","runs":[{"text":"Các phần của chính truyến\n","bold":true}]}]},{"colSpan":1,"rowSpan":3,"blocks":[{"type":"paragraph","id":"p-186061","runs":[{"text":"Note\n","bold":true,"italic":true}]}]}]},{"cells":[{"colSpan":2,"rowSpan":1,"blocks":[]},{"colSpan":4,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-186074","runs":[{"text":"Liên quan trực tiếp đến chính tuyến","bold":true},{"text":"\n"}]}]}]},{"cells":[{"colSpan":2,"rowSpan":1,"blocks":[]},{"colSpan":2,"rowSpan":1,"blocks":[]},{"colSpan":2,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-186130","runs":[{"text":"Liên quan đến khu vực phụ\n","bold":true}]}]}]},{"cells":[{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-186162","runs":[{"text":"P0.1\n"}]}]},{"colSpan":2,"rowSpan":1,"blocks":[]},{"colSpan":4,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-186172","runs":[{"text":"Darkon's Elegy"},{"text":"\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[]}]},{"cells":[{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-186197","runs":[{"text":"P0.2\n"}]}]},{"colSpan":2,"rowSpan":1,"blocks":[]},{"colSpan":4,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-186207","runs":[{"text":"Temple of Light Invasion"},{"