iki.wikidot.com/dragonspire"},{"text":", "},{"text":"/join shadowspire","href":"http://aqwwiki.wikidot.com/shadowspire"},{"text":", and "},{"text":"/join queenspire","href":"http://aqwwiki.wikidot.com/queenspire"},{"text":" for Good, Evil, and Chaos respectively).\n"}]},{"type":"paragraph","id":"p-167368","runs":[{"text":"→ Feverfew Falls, battle to discover General Tyndarius' plans for the children kidnapped from there ("},{"text":"/join feverfew","href":"http://aqwwiki.wikidot.com/feverfew"},{"text":").\n"}]},{"type":"paragraph","id":"p-167486","runs":[{"text":"→ Phoenixrise Gates, battle through the caverns of the Phoenixrise Gates and defeat Cinderclaw the Ravenous ("},{"text":"/join phoenixrise","href":"http://aqwwiki.wikidot.com/phoenixrise"},{"text":").\n"}]},{"type":"paragraph","id":"p-167615","runs":[{"text":"→ Firestorm Forge, battle through a gauntlet of Firestorm Onslaught Soldiers ("},{"text":"/join fireforge","href":"http://aqwwiki.wikidot.com/firestorm-forge"},{"text":").\n"}]},{"type":"paragraph","id":"p-167711","runs":[{"text":"→ Embersea Finale, defeat Tyndarius ("},{"text":"/join lavarun","href":"http://aqwwiki.wikidot.com/lavarun"},{"text":").\n"}]},{"type":"paragraph","id":"p-167765","runs":[{"text":"Video "},{"text":"FULL Walkthrough","bold":true,"italic":true},{"text":":\n"}]},{"type":"paragraph","id":"p-167789","runs":[{"text":"→ Từ Embersea đến Feverfew Falls: "},{"text":"Click here","italic":true,"href":"https://www.youtube.com/watch?v=xgOuUDfsxmo"},{"text":"\n"}]},{"type":"paragraph","id":"p-167834","runs":[{"text":"→ Phoenixrise Gates và "},{"text":"Firestorm Forge: "},{"text":"Click here","italic":true,"href":"https://www.youtube.com/watch?v=uH6yWzARv3c"},{"text":"\n"}]},{"type":"paragraph","id":"p-167885","runs":[{"text":"→ Embersea Finale: "},{"text":"Click here","italic":true,"href":"https://www.youtube.com/watch?v=ADgVQF7gi3g"},{"text":"\n"}]},{"type":"paragraph","id":"p-167915","runs":[{"text":"→ Brimstone "},{"text":"(member only)"