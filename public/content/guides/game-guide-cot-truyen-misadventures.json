{"sections":[{"id":"noi-dung","title":"Nội dung hướng dẫn","paragraphs":[],"blocks":[{"type":"paragraph","id":"p-198911","runs":[{"text":"Đây là tập hợp các tuyến truyện phụ tuyến khác, không liên quan đến các cốt truyện chính tuyến được kể ở trên, cũng như không liên qua đến nhau hoặc chưa thể xác định được vị trí của chúng trong dòng thời gian chính hoặc có một phần liên quan nhưng không phải toàn bộ.\n"}]}]},{"id":"cac-chu-de","title":"Các chủ đề trong chương","paragraphs":[],"links":[{"title":"Sepulchure's Saga","url":"/cot-truyen/sepulchure-s-saga"},{"title":"J6 Saga","url":"/cot-truyen/j6-saga"},{"title":"Nulgath's Saga","url":"/cot-truyen/nulgath-s-saga"},{"title":"Dage's Saga","url":"/cot-truyen/dage-s-saga"},{"title":"The Throne of Darkness Saga","url":"/cot-truyen/the-throne-of-darkness-saga"},{"title":"Return of the Devs","url":"/cot-truyen/return-of-the-devs"},{"title":"The Seven Deadly Dragons Saga - Mysterious Egg","url":"/cot-truyen/the-seven-deadly-dragons-saga-mysterious-egg"},{"title":"Memet's Realm","url":"/cot-truyen/memet-s-realm"},{"title":"Crystallis Saga","url":"/cot-truyen/crystallis-saga"},{"title":"The Hollowborn Saga","url":"/cot-truyen/the-hollowborn-saga"},{"title":"Diabolical Saga","url":"/cot-truyen/diabolical-saga"},{"title":"Doom Vault Dungeon Map","url":"/cot-truyen/doom-vault-dungeon-map"},{"title":"Tercessuinotlim Navigation","url":"/cot-truyen/tercessuinotlim-navigation"}]}],"previous":{"title":"Chương 4: Age of Ruin","url":"/cot-truyen/chuong-4-age-of-ruin"},"missingImageCount":0}