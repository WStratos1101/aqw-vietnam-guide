{"sections":[{"id":"noi-dung","title":"Nội dung hướng dẫn","paragraphs":[],"blocks":[{"type":"paragraph","id":"p-208232","runs":[{"text":"Phần truyện độc lập của Kotaro.\n"}]},{"type":"paragraph","id":"p-208265","runs":[{"text":"→ "},{"text":"Part 1:","bold":true},{"text":" Kotaro is a member of the Crystallis faction and can be found in the "},{"text":"/join onsen","href":"http://aqwwiki.wikidot.com/future-of-akiba"},{"text":" bathhouse.\n"}]},{"type":"paragraph","id":"p-208367","runs":[{"text":"→ "},{"text":"Part 2:","bold":true},{"text":" Kotaro's Akiba is a futuristic world, but he has kept some secrets from you, so you won't be able to enjoy an easy afternoon adventure ("},{"text":"/join shinkansen","href":"http://aqwwiki.wikidot.com/shinkansen"},{"text":").\n"}]},{"type":"paragraph","id":"p-208532","runs":[{"text":"→ "},{"text":"Part 3:","bold":true},{"text":" Eden City is a popular destination, but there are anomalies in the immediate vicinity and a threat assessment is underway ("},{"text":"/join eden","href":"http://aqwwiki.wikidot.com/eden-city"},{"text":").\n"}]},{"type":"paragraph","id":"p-208679","runs":[{"text":"Video "},{"text":"FULL Walkthrough","bold":true,"italic":true},{"text":": "},{"text":"Onsen","href":"https://www.youtube.com/watch?v=6DVlqvKnzes"},{"text":" - "},{"text":"Shinkansen","href":"https://www.youtube.com/watch?v=1yNOgiKYm60"},{"text":" - "},{"text":"Eden City","href":"https://www.youtube.com/watch?v=AkLKrc2e65w"},{"text":"\n"}]}]}],"previous":{"title":"Memet's Realm","url":"/cot-truyen/memet-s-realm"},"next":{"title":"The Hollowborn Saga","url":"/cot-truyen/the-hollowborn-saga"},"missingImageCount":1}