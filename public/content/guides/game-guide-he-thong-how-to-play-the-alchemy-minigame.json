href":"http://aqwwiki.wikidot.com/roc-tongue"},{"text":" - Drop từ Rock Roc ở "},{"text":"/join roc","href":"http://aqwwiki.wikidot.com/rock-roc-location"},{"text":".\n"}]},{"type":"paragraph","id":"p-82762","listDepth":0,"runs":[{"text":"Searbush","href":"http://aqwwiki.wikidot.com/searbush"},{"text":" - Drop từ Living Fire và Sulfur Imps ở "},{"text":"/join firestorm","href":"http://aqwwiki.wikidot.com/fire-storm"},{"text":".\n"}]},{"type":"paragraph","id":"p-82827","listDepth":0,"runs":[{"text":"Trollola Nectar","href":"http://aqwwiki.wikidot.com/trollola-nectar"},{"text":" - Drop từ Trollola Plants ở "},{"text":"/join bloodtusk","href":"http://aqwwiki.wikidot.com/bloodtusk-ravine"},{"text":".\n"}]}]},{"id":"h.h1ezfnoo82d5","title":"Hướng dẫn chơi minigame","paragraphs":[],"blocks":[{"type":"paragraph","id":"p-82913","runs":[{"text":"B1:","bold":true},{"text":" Đầu tiên bạn cần phải chọn loại thuốc bạn muốn chế từ "},{"text":"list này","href":"http://aqwwiki.wikidot.com/use-items"},{"text":", sau đó tìm nguyên liệu yêu cầu cho loại thuốc đó từ danh sách bên trên.\n"}]},{"type":"paragraph","id":"p-83054","runs":[{"text":"B2:","bold":true},{"text":" ","bold":true},{"text":"Khi đã có đầy đủ nguyên liệu cần, đến "},{"text":"/join alchemy","href":"http://aqwwiki.wikidot.com/alchemy-location"},{"text":". Có 2 phương pháp điều chế thuốc khác nhau mà bạn có thể lựa chọn:\n"}]},{"type":"paragraph","id":"p-83177","runs":[{"text":"◆ "},{"text":"PP1:","italic":true},{"text":" Chế thuốc "},{"text":"theo nhóm loại/tác dụng","bold":true,"italic":true},{"text":" thuốc. Tức là ngoài phải có đúng nguyên liệu, bạn còn phải chọn đúng loại/tác dụng thuốc. Nhưng lưu ý PP này không cho chọn nguyên liệu, nên bạn chỉ để 2 nguyên liệu cần sử dụng trong túi để tránh sai sót. Có 2 cách thực:\n"}]},{"type":"paragraph","id":"p-83440","runs":[{"text":"→ "},{"text":"Sử dụng ","bold":true,"italic":true},{"text":"Dragon Runestone","bold":true,"italic":true,"href":"http://aqwwiki.wikidot.com/dragon-runestone"},{"text":" để tự động chế thuốc. Cách này chỉ chế ra loại thuốc tốt nhất nên có thể sẽ không chế được hay tỷ lệ rất thấp ra loại bạn cần.\n"}]},{"type":"paragraph","id":"p-83596","runs":[{"text":"→ "},{"text":"Không","bold":true,"italic":true},{"text":" sử dụng "},{"text":"Dragon Runestone","bold":true,"italic":true,"href":"http://aqwwiki.wikidot.com/dragon-runestone"},{"text":" vì vậy bạn phải tự chế thuốc thủ công.\n"}]},{"type":"paragraph","id":"p-83671","runs":[{"text":"◆ "},{"text":"PP2:","italic":true},{"text":" Chế thuốc "},{"text":"theo nhóm nguyên liệu","bold":true,"italic":true},{"text":", đơn giản là sẽ chế ra tất cả loại thuốc tạo ra từ loại nguyên liệu đó, có 2 cách sau:\n"}]},{"type":"paragraph","id":"p-83797","runs":[{"text":"→ Dùng "},{"text":"Dragon Runestone","bold":true,"italic":true,"href":"http://aqwwiki.wikidot.com/dragon-runestone"},{"text":" như ở PP1 nhưng cho chọn nguyên liệu "},{"text":"(trước bước chọn nguyên liệu thì có cho chọn Rune)","italic":true},{"text":". \n"}]},{"type":"paragraph","id":"p-83911","runs":[{"text":"→ Với cách "},{"text":"không dùng","bold":true,"italic":true},{"text":" thì bạn có thể chọn loại Rune và chọn nguyên liệu chế.\n"}]},{"type":"paragraph","id":"p-83993","runs":[{"text":"B3:","bold":true},{"text":" ","bold":true},{"text":"Tiếp theo cần chọn đúng loại Rune cần dùng để chế thuốc, bằng cách check "},{"text":"Base Level","bold":true},{"text":" của loại thuốc đó trên "},{"text":"Wiki","href":"http://aqwwiki.wikidot.com/use-items"},{"text":". Sau đó khớp với guide sau:\n"}]},{"type":"table","id":"table-84137","rows":[{"cells":[{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84140","runs":[{"text":"Loại Rune\n","bold":true}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84151","runs":[{"text":"Base Level\n","bold":true}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84163","runs":[{"text":"Reputation\n","bold":true}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84175","runs":[{"text":"Use Dragon Runes\n","bold":true}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84193","runs":[{"text":"Rank to Unlock\n","bold":true}]}]}]},{"cells":[{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84210","runs":[{"text":"Jera","bold":true},{"text":"\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84216","runs":[{"text":"Level 5-15\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84228","runs":[{"text":"300 Rep\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84237","runs":[{"text":"1000 Rep\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84247","runs":[{"text":"N/A\n"}]}]}]},{"cells":[{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84253","runs":[{"text":"Uruz","bold":true},{"text":"\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84259","runs":[{"text":"Level 16-25\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84272","runs":[{"text":"900 Rep\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84281","runs":[{"text":"1500 Rep\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84291","runs":[{"text":"Rank 3 Alchemy\n"}]}]}]},{"cells":[{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84308","runs":[{"text":"Fehu","bold":true},{"text":"\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84314","runs":[{"text":"Level 26-40\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84327","runs":[{"text":"2000 Rep\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84337","runs":[{"text":"3500 Rep\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84347","runs":[{"text":"Rank 5 Alchemy\n"}]}]}]},{"cells":[{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84364","runs":[{"text":"Gebo","bold":true},{"text":"\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84370","runs":[{"text":"Level 41+\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84381","runs":[{"text":"5000 Rep\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84391","runs":[{"text":"6500 Rep\n"}]}]},{"colSpan":1,"rowSpan":1,"blocks":[{"type":"paragraph","id":"p-84401","runs":[{"text":"Rank 8 Alchemy\n"}]}]}]}]},{"type":"paragraph","id":"p-84420","runs":[{"text":"B4:","bold":true},{"text":" Tuỳ theo "},{"text":"Phương pháp","bold":true,"italic":true},{"text":" mà bạn chọn ở "},{"text":"B2","bold":true,"italic":true},{"text":":\n"}]},{"type":"paragraph","id":"p-84463","runs":[{"text":"◆ "},{"text":"PP1:","italic":true},{"text":" Chọn "},{"text":"nhóm loại/tác dụng","bold":true,"italic":true},{"text":" thuốc. Gồm 3 loại Potion - Tonic - Elixir:\n"}]},{"type":"paragraph","id":"p-84539","runs":[{"text":"Sau đó chọn tác dụng muốn chế, nên xem tác dụng loại thuốc mà bạn muốn chế để chọn đúng. Rồi bấm "},{"text":"Begin","bold":true},{"text":" để bắt đầu.\n"}]},{"type":"paragraph","id":"p-84655","runs":[{"text":"◆ "},{"text":"PP2:","italic":true},{"text":" Chọn "},{"text":"tổ hợp nguyên liệu","bold":true,"italic":true},{"text":". Sau đó nhấn "},{"text":"Begin","bold":true},{"text":" để bắt đầu.\n"}]},{"type":"paragraph","id":"p-84720","runs":[{"text":"B5:","bold":true},{"text":" Thực hiện điều chế "},{"text":"(không áp dụng với cách dùng “Dragon Runestone” vì đến bước này sẽ tự động làm)","italic":true},{"text":":"},{"text":"\n"}]},{"type":"paragraph","id":"p-84824","runs":[{"text":"Trong minigame này, bạn cần phải đổ đầy một lọ thuốc rỗng. Để đạt được hiệu quả cao, cần phải cân bằng nhiệt của máy điều chế để nó duy trì công suất cao nhất là "},{"text":"3 đèn màu xanh hoặc ít nhất là 2 đèn","bold":true,"italic":true},{"text":". Điều này có thể thực hiện được bằng cách giữ nhiệt đồ hỗn hợp ở khoảng "},{"text":"70-80 độ","bold":true,"italic":true},{"text":". Sử dụng "},{"text":"nút đỏ để tăng nhiệt","bold":true,"italic":true},{"text":" hoặc "},{"text":"nút xanh để đóng băng","bold":true,"italic":true},{"text":" RuneStone và ngăn nó bị quá nhiệt.\n"}]},{"type":"paragraph","id":"p-85196","runs":[{"text":"Rune càng xịn thì càng dễ bị quá nhiệt. Đôi khi, một quả cầu lửa sẽ không trúng RuneStone và thay vào đó sẽ làm căn phòng bị bốc cháy và đưa đồng hồ đo lên 100 độ, điều này bạn không thể tránh khỏi. Tương tự, băng có thể không làm nguội được RuneStone dù nó đặt đồng hồ đo ở mức -30 độ. Nếu điều này xảy ra, bạn có thể khởi động lại minigame vì bạn sẽ không mất bất kỳ nguyên liệu nào.\n"}]},{"type":"paragraph","id":"p-85584","runs":[{"text":"Video Alchemy Minigame:","bold":true},{"text":" "},{"text":"Click here","italic":true,"href":"https://www.youtube.com/watch?v=E3PNDk91WZM"},{"text":"\n"}]},{"type":"paragraph","id":"p-85620","runs":[{"text":"Có 4 loại thuốc được tạo ra từ Minigame này:\n","bold":true}]},{"type":"paragraph","id":"p-85665","runs":[{"text":"→ "},{"text":"Potions","bold":true},{"text":" - Có thời gian hiệu lực ngắn "},{"text":"(thường từ 15-45s)","italic":true},{"text":" vì vậy dùng trong trận chiến hơn là dùng trước khi bắt đầu. Loại này giúp tăng secondary stats, như haste, evasion, crit chance và hơn thế nữa. Cũng có cả hồi mana và health.\n"}]},{"type":"paragraph","id":"p-85898","runs":[{"text":"→ "},{"text":"Tonics","bold":true},{"text":" - Có thời gian hiệu lực dài "},{"text":"(lên đến 15 phút)","italic":true},{"text":" vì vậy có thể sử dụng chúng trước khi vào chiến như một sự chuẩn bị. Loại này giúp tăng primary stats "},{"text":"(strength, dexterity, intelligence, endurance, wisdom hoặc luck)","italic":true},{"text":".\n"}]},{"type":"paragraph","id":"p-86121","runs":[{"text":"→ "},{"text":"Elixirs","bold":true},{"text":" - Elixirs là dạng dung hợp của potions và tonics. Loại này giúp tăng secondary stats "},{"text":"(dù nhỏ hơn hiệu ứng mà bạn nhận từ potions)","italic":true},{"text":" trong một thời gian hiệu lực dài, giống như tonics.\n"}]},{"type":"paragraph","id":"p-86313","runs":[{"text":"→ "},{"text":"Unstable","bold":true},{"text":" - Đôi khi bạn có thể tạo một biến thể không ổn định của potions, tonics và elixirs. Chúng sẽ có buff tốt hơn nhưng đồng thời cũng đi kèm một điểm yếu. Ví dụ, Unstable Karma Tonic tăng luck lên 16% nhưng giảm endurance đi 10% trong 7 phút.\n"}]},{"type":"paragraph","id":"p-86563","runs":[{"text":"→ Hiện tại khá nhiều các loại thuốc có thể mua bằng Gold mà không cần phải thông qua minigame này để lấy nữa, xem thêm tại “"},{"text":"Potions Guide","bold":true,"italic":true,"href":"/class/use-potions-and-scrolls-for-support"},{"text":"”.\n"}]}]},{"id":"h.sgh3kt1pisua","title":"Cách Rank up Rep Alchemy","paragraphs":[],"blocks":[{"type":"paragraph","id":"p-86729","runs":[{"text":"Để Rank up nhanh, mua 30 Chaoroot và Necrot trong "},{"text":"Swindle's Ripoff Emporium","href":"http://aqwwiki.wikidot.com/swindle-s-ripoff-emporium"},{"text":" ở "},{"text":"/join tercessuinotlim"},{"text":". Dùng nó cho loại Rune cao nhất mà bạn có sử dụng. Easy! Tốt nhất nên sử dụng "},{"text":"Dragon Runestone","href":"http://aqwwiki.wikidot.com/dragon-runestone"},{"text":" "},{"text":"(100k Gold/cục)","italic":true},{"text":" để tự động chế thuốc đồng thời lượng Rep mỗi Rune nhận được sẽ nhiều hơn, điều này giúp bạn Rank up nhanh hơn.\n"}]},{"type":"paragraph","id":"p-87053","runs":[{"text":"Đầu tiên chọn "},{"text":"Continue","bold":true},{"text":" → "},{"text":"+Bonus rep","bold":true},{"text":" → "},{"text":"Continue","bold":true},{"text":" → Chọn loại "},{"text":"Rune cao nhất","bold":true},{"text":" bạn có thể sử dụng → Chọn "},{"text":"Chaoroot","bold":true},{"text":" và "},{"text":"Necrot","bold":true},{"text":" → "},{"text":"Begin","bold":true},{"text":" → Bấm nút lửa "},{"text":"(đỏ)","italic":true},{"text":" để bắt đầu tự động điều chế.\n"}]}]},{"id":"h.nhq6ohv3d6lj","title":"Useful Potions","paragraphs":[],"blocks":[{"ty